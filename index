  try{await downloads.save({filename:"ausencias-"+hoy()+".csv",data});}catch(e){if(e&&e.code!=="declined")toast("No se pudo descargar el archivo.");}
});

/* ---------- REGISTRAR ---------- */
let editAus=null;
function opcionesEmp(sel,{todos,soloActivos}={}){
  const el=$(sel);const v=el.value;
  const lista=S.emp.filter(e=>!soloActivos||e.activo!==false||e.id===v).sort(nombreOrd);
  el.innerHTML=(todos?`<option value="">${todos}</option>`:(lista.length?"":`<option value="">Agrega empleados primero</option>`))+lista.map(e=>`<option value="${esc(e.id)}">${esc(e.nombre)}${e.activo===false?" (inactivo)":""}</option>`).join("");
  if([...el.options].some(o=>o.value===v))el.value=v;
}
function tipoSel(){return document.querySelector('input[name="a-tipo"]:checked').value;}
function toggleJus(){$("#a-jus-campos").style.display=tipoSel()==="justificada"?"grid":"none";}
$$('input[name="a-tipo"]').forEach(r=>r.addEventListener("change",toggleJus));
$("#a-desde").addEventListener("change",()=>{const d=$("#a-desde").value,h=$("#a-hasta").value;if(!h||h<d)$("#a-hasta").value=d;});
function resetAus(){
  editAus=null;$("#f-aus").reset();$("#a-desde").value=hoy();$("#a-hasta").value=hoy();toggleJus();
  $("#a-titulo").textContent="Registrar ausencia";$("#a-guardar").textContent="Guardar ausencia";$("#a-cancelar").hidden=true;
}
$("#a-cancelar").addEventListener("click",resetAus);
$("#f-aus").addEventListener("submit",async e=>{
  e.preventDefault();
  const emp=$("#a-emp").value,desde=$("#a-desde").value;let hasta=$("#a-hasta").value||desde;
  if(!emp){toast("Elige un empleado.");return;}
  if(!desde){toast("Indica la fecha de la ausencia.");return;}
  if(hasta<desde){toast("La fecha final no puede ser anterior a la inicial.");return;}
  const choque=S.abs.find(a=>a.empleadoId===emp&&a.id!==editAus&&a.desde<=hasta&&(a.hasta||a.desde)>=desde);
  if(choque){toast("Ya hay una ausencia registrada para esa persona entre "+fmt(choque.desde)+" y "+fmt(choque.hasta||choque.desde)+".");return;}
  const tipo=tipoSel();
  const prev=editAus?S.abs.find(a=>a.id===editAus):null;
  const data={empleadoId:emp,desde,hasta,tipo,motivo:tipo==="justificada"?$("#a-motivo").value:"",soporte:tipo==="justificada"?$("#a-soporte").checked:false,obs:$("#a-obs").value.trim(),creado:prev&&prev.creado?prev.creado:new Date().toISOString()};
  const b=$("#a-guardar");b.disabled=true;
  try{await guardar("ausencias",editAus||nid(),data);toast(editAus?"Ausencia actualizada":"Ausencia guardada");const keep=emp;resetAus();$("#a-emp").value=keep;}catch(err){fallo(err);}
  b.disabled=false;
});
