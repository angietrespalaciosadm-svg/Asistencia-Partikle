  const n=id=>Math.max(1,parseInt($(id).value,10)||1);
  let seg=n("#cfg-seg"),com=n("#cfg-com");if(com<seg)com=seg;
  guardarCfg({umbralSeg:seg,umbralCom:com,umbralJust:n("#cfg-jus"),sabados:$("#cfg-sab").checked}).then(()=>toast("Ajustes guardados")).catch(fallo);
