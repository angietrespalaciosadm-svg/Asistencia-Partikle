$("#exportar").addEventListener("click",async()=>{
  const q=v=>'"'+String(v==null?"":v).replace(/"/g,'""')+'"';
  const lines=[["Empleado","Documento","Área","Desde","Hasta","Días","Tipo","Motivo","Soporte","Observaciones"].map(q).join(";")];
  [...S.abs].sort((a,b)=>a.desde.localeCompare(b.desde)).forEach(a=>{const e=empById(a.empleadoId)||{};
    lines.push([e.nombre,e.documento,e.area,a.desde,a.hasta||a.desde,diasDe(a).length,a.tipo==="injustificada"?"Sin justificar":"Justificada",a.tipo==="justificada"?a.motivo:"",a.tipo==="justificada"?(a.soporte?"Sí":"No"):"",a.obs].map(q).join(";"));});
