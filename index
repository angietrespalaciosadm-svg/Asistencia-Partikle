$("#fa-emp").addEventListener("change",renderAusencias);$("#fa-tipo").addEventListener("change",renderAusencias);
$("#lista-aus").addEventListener("click",async e=>{
  const ed=e.target.closest("[data-edit-aus],[data-justificar]");
  if(ed){const id=ed.dataset.editAus||ed.dataset.justificar;const a=S.abs.find(x=>x.id===id);if(!a)return;
    editAus=id;$("#a-emp").value=a.empleadoId;$("#a-desde").value=a.desde;$("#a-hasta").value=a.hasta||a.desde;
    const t=ed.dataset.justificar?"justificada":a.tipo;document.querySelector(`input[name="a-tipo"][value="${t}"]`).checked=true;
    if(a.motivo)$("#a-motivo").value=a.motivo;$("#a-soporte").checked=ed.dataset.justificar?true:!!a.soporte;$("#a-obs").value=a.obs||"";toggleJus();
    $("#a-titulo").textContent="Editar ausencia";$("#a-guardar").textContent="Guardar cambios";$("#a-cancelar").hidden=false;window.scrollTo(0,0);return;}
  const d=e.target.closest("[data-del-aus]");
  if(d){if(!confirm("¿Eliminar este registro de ausencia?"))return;try{await borrar("ausencias",d.dataset.delAus);toast("Registro eliminado");}catch(err){fallo(err);}}
});

/* ---------- EMPLEADOS ---------- */
let editEmp=null;
function resetEmp(){editEmp=null;$("#f-emp").reset();$("#e-guardar").textContent="Agregar empleado";$("#e-cancelar").hidden=true;$("#e-titulo").textContent="Empleados";}
$("#e-cancelar").addEventListener("click",resetEmp);
$("#f-emp").addEventListener("submit",async e=>{
  e.preventDefault();const nombre=$("#e-nombre").value.trim();if(!nombre){toast("Escribe el nombre.");$("#e-nombre").focus();return;}
  const prev=editEmp?empById(editEmp):null;
  const data={nombre,documento:$("#e-doc").value.trim(),cargo:$("#e-cargo").value.trim(),area:$("#e-area").value.trim(),correo:$("#e-correo").value.trim(),activo:prev?prev.activo!==false:true};
  try{await guardar("empleados",editEmp||nid(),data);toast(editEmp?"Datos actualizados":nombre+" agregado");resetEmp();$("#e-nombre").focus();}catch(err){fallo(err);}
});
$("#e-lote-btn").addEventListener("click",async()=>{
  const lineas=$("#e-lote").value.split(/\r?\n/).map(l=>l.trim()).filter(Boolean);
  if(!lineas.length){toast("Pega al menos un nombre.");return;}
  const ex=new Set(S.emp.map(e=>String(e.nombre).toLowerCase()));let n=0,rep=0;
  for(const l of lineas){const p=l.split(/[;\t]/).map(x=>x.trim());if(!p[0])continue;if(ex.has(p[0].toLowerCase())){rep++;continue;}
    try{await guardar("empleados",nid(),{nombre:p[0],cargo:p[1]||"",area:p[2]||"",correo:p[3]||"",documento:"",activo:true});ex.add(p[0].toLowerCase());n++;}catch(err){fallo(err);break;}}
  $("#e-lote").value="";toast(n+" agregados"+(rep?", "+rep+" ya existían":""));
});
function renderEmpleados(){
  const box=$("#lista-emp");
  if(!S.emp.length){box.innerHTML=`<div class="empty">Agrega a la primera persona con el formulario de arriba.</div>`;return;}
  const A=analizar(S.period);const m=new Map(A.filas.map(r=>[r.emp.id,r]));
  const lista=[...S.emp].sort((a,b)=>(a.activo===false)-(b.activo===false)||nombreOrd(a,b));
  box.innerHTML=`<p class="small muted" style="margin:0 0 8px">${S.emp.filter(e=>e.activo!==false).length} activos · conteos de: ${PER[S.period].toLowerCase()}</p><div class="tbl-wrap"><table class="num"><thead><tr><th>Nombre</th><th>Cargo y área</th><th>Correo</th><th class="n">Sin justificar</th><th class="n">Justificadas</th><th></th></tr></thead><tbody>`+
    lista.map(e=>{const r=m.get(e.id);const tiene=S.abs.some(a=>a.empleadoId===e.id);
      return `<tr${e.activo===false?' class="muted"':""}><td><b>${esc(e.nombre)}</b>${e.documento?`<div class="small muted">${esc(e.documento)}</div>`:""}${e.activo===false?'<div class="small">Inactivo</div>':""}</td>
      <td>${esc([e.cargo,e.area].filter(Boolean).join(" · "))}</td><td class="small">${esc(e.correo||"")}</td>
      <td class="n ${r&&r.inj.length?"tag-i":""}">${r?r.inj.length:0}</td><td class="n">${r?r.jus.length:0}</td>
      <td style="white-space:nowrap"><button class="btn link sm" data-edit-emp="${esc(e.id)}">Editar</button><button class="btn link sm" data-act-emp="${esc(e.id)}">${e.activo===false?"Reactivar":"Desactivar"}</button>${tiene?"":`<button class="btn link sm danger" data-del-emp="${esc(e.id)}">Eliminar</button>`}</td></tr>`;}).join("")+`</tbody></table></div>`;
}
$("#lista-emp").addEventListener("click",async e=>{
  const ed=e.target.closest("[data-edit-emp]");
  if(ed){const x=empById(ed.dataset.editEmp);if(!x)return;editEmp=x.id;$("#e-nombre").value=x.nombre||"";$("#e-doc").value=x.documento||"";$("#e-cargo").value=x.cargo||"";$("#e-area").value=x.area||"";$("#e-correo").value=x.correo||"";
    $("#e-guardar").textContent="Guardar cambios";$("#e-cancelar").hidden=false;$("#e-titulo").textContent="Editar empleado";window.scrollTo(0,0);$("#e-nombre").focus();return;}
  const ac=e.target.closest("[data-act-emp]");
  if(ac){const x=empById(ac.dataset.actEmp);if(!x)return;try{await guardar("empleados",x.id,Object.assign(limpio(x),{activo:x.activo===false}));}catch(err){fallo(err);}return;}
  const d=e.target.closest("[data-del-emp]");
  if(d){const x=empById(d.dataset.delEmp);if(!x||!confirm("¿Eliminar a "+x.nombre+"?"))return;try{await borrar("empleados",x.id);toast("Empleado eliminado");}catch(err){fallo(err);}}
});

/* ---------- COMUNICADOS ---------- */
function llenarPerCom(){const el=$("#c-per");if(el.options.length)return;el.innerHTML=Object.keys(PER).map(k=>`<option value="${k}">${PER[k]}</option>`).join("");el.value=S.period;}
function sugerencia(){
  const id=$("#c-emp").value;const p=$("#c-per").value||S.period;const el=$("#c-sugerencia");
  if(!id){el.textContent="";return;}
  const r=analizar(p).filas.find(x=>x.emp.id===id);if(!r){el.textContent="";return;}
  const u=ultimoCom(id);
  el.textContent=`${r.emp.nombre}: ${r.inj.length} sin justificar y ${r.jus.length} justificadas en el periodo. `+(r.est.tipo?`Sugerido: ${TIPOS[r.est.tipo].toLowerCase()}.`:"No supera ningún umbral de alerta.")+(u?` Último comunicado: ${TIPOS[u.tipo]||u.tipo}, ${fmt(u.fecha)}.`:"");
}
$("#c-emp").addEventListener("change",sugerencia);$("#c-per").addEventListener("change",sugerencia);
function listaFechas(items,conMotivo){
  if(!items.length)return "  (No hay registros de este tipo en el periodo seleccionado.)";
  return items.map(a=>{const n=a.dias.length;const r=(a.hasta&&a.hasta!==a.desde)?`del ${fmtL(a.desde)} al ${fmtL(a.hasta)}`:fmtL(a.desde);
    return `  • ${r.charAt(0).toUpperCase()+r.slice(1)} (${n} ${n===1?"día":"días"})${conMotivo&&a.motivo?" – "+a.motivo:""}`;}).join("\n");
}
function carta(empId,tipo,p){
  const c=cfg();const A=analizar(p);const r=A.filas.find(x=>x.emp.id===empId);if(!r)return {asunto:"",texto:""};
  const e=r.emp;const pn=String(e.nombre||"").split(/\s+/)[0];
  const desde=p==="todo"?(([...r.inj,...r.jus].map(a=>a.desde).sort()[0])||hoy()):A.ini;
  const sinDia=x=>fmtL(x).replace(/^\S+ /,"");const rango=`entre el ${sinDia(desde)} y el ${sinDia(hoy())}`;
  const firma=`

Atentamente,

Talento Humano`;
  let asunto,cuerpo;
  if(tipo==="descargos"){
    asunto="Citación a diligencia de descargos por inasistencias sin justificar";
    cuerpo=`Respetado(a) ${pn}:

Por medio de la presente, el área de Talento Humano le informa que en los registros de asistencia de la empresa figuran las siguientes inasistencias a su jornada laboral, ocurridas ${rango}, sin que a la fecha se haya presentado una justificación o un soporte que las respalde:

${listaFechas(r.inj)}

En total: ${r.inj.length} ${r.inj.length===1?"inasistencia":"inasistencias"}, equivalentes a ${r.dInj} ${r.dInj===1?"día":"días"} de trabajo.

Cumplir la jornada y avisar oportunamente cualquier ausencia es una obligación del contrato de trabajo y del Reglamento Interno de Trabajo. Por esta razón, y en garantía de su derecho al debido proceso, lo(a) citamos a una diligencia de descargos que se realizará el día ______ de __________ a las ______, en ____________________, para que exponga las razones de estas ausencias y aporte las pruebas que considere pertinentes.

Puede asistir acompañado(a) en los términos que establece el Reglamento Interno de Trabajo. Si cuenta con soportes que justifiquen alguna de estas fechas, le pedimos entregarlos a Talento Humano antes de la diligencia.`;
  }else if(tipo==="justificadas"){
    asunto="Seguimiento a sus ausencias justificadas";
    cuerpo=`Respetado(a) ${pn}:

Desde Talento Humano hacemos seguimiento al ausentismo de todo el equipo, con el propósito de cuidar el bienestar de las personas y la continuidad del trabajo. ${rango.charAt(0).toUpperCase()+rango.slice(1)} hemos registrado las siguientes ausencias justificadas a su nombre:

${listaFechas(r.jus,true)}

En total: ${r.jus.length} ${r.jus.length===1?"ausencia":"ausencias"} (${r.dJus} ${r.dJus===1?"día":"días"}).

Le agradecemos haber informado y soportado cada una de ellas. Dado el número de ausencias, queremos invitarle a una conversación con Talento Humano para saber cómo se encuentra y revisar si necesita algún apoyo, por ejemplo orientación con su EPS, ajustes en su puesto o en sus condiciones de trabajo, o el acompañamiento del área de Seguridad y Salud en el Trabajo.

Por favor indíquenos qué día y hora de esta semana le queda bien. Esta conversación no tiene carácter disciplinario.`;
  }else{
    asunto="Recordatorio sobre la asistencia y el reporte de ausencias";
    cuerpo=`Respetado(a) ${pn}:

Desde Talento Humano queremos recordarle la importancia de cumplir con su jornada laboral y de informar a tiempo cualquier ausencia. En nuestros registros aparecen las siguientes fechas sin justificación, ${rango}:

${listaFechas(r.inj)}

Si se presenta una situación que le impida asistir, le pedimos avisar a su jefe inmediato antes del inicio de la jornada y entregar el soporte correspondiente a Talento Humano tan pronto como le sea posible. Si cuenta con soportes para alguna de las fechas anteriores, puede hacérnoslos llegar para actualizar su registro.

Si hay alguna situación personal o laboral que esté afectando su asistencia, nuestra área está disponible para escucharle y buscar alternativas. Contamos con su compromiso.`;
  }
  return {asunto,texto:cuerpo+firma};
}
let enCurso=null;
function generar(){
  const id=$("#c-emp").value;if(!id){toast("Elige un empleado.");return;}
  if(enCurso){enCurso.abort();enCurso=null;}
  const k=carta(id,$("#c-tipo").value,$("#c-per").value||S.period);
  $("#c-asunto").value=k.asunto;$("#c-texto").value=k.texto;
  $("#c-editor").hidden=false;actGmail();$("#c-mejorar").textContent="Mejorar redacción con Claude";
}
$("#c-generar").addEventListener("click",generar);
function actGmail(){
  const e=empById($("#c-emp").value);const to=(e&&e.correo)||"";
  $("#c-para").value=to?(e.nombre+" <"+to+">"):"Esta persona no tiene correo registrado";
  $("#c-gmail").href="https://mail.google.com/mail/?view=cm&fs=1&to="+encodeURIComponent(to)+"&su="+encodeURIComponent($("#c-asunto").value)+"&body="+encodeURIComponent($("#c-texto").value);
}
$("#c-asunto").addEventListener("input",actGmail);$("#c-texto").addEventListener("input",actGmail);$("#c-emp").addEventListener("change",actGmail);
$("#c-copiar").addEventListener("click",async()=>{
  const t=$("#c-texto");
  try{await navigator.clipboard.writeText(t.value);toast("Texto copiado");}
  catch(e){t.select();try{document.execCommand("copy");toast("Texto copiado");}catch(_){toast("Selecciona el texto y cópialo manualmente.");}}
});
$("#c-descargar").addEventListener("click",async()=>{
  if(!downloads)return;const e=empById($("#c-emp").value);
  const nom=(e?e.nombre:"comunicado").normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/[^A-Za-z0-9]+/g,"-").toLowerCase();
  try{await downloads.save({filename:`comunicado-${nom}-${hoy()}.txt`,data:$("#c-texto").value});}catch(err){if(err&&err.code!=="declined")toast("No se pudo descargar.");}
});
$("#c-registrar").addEventListener("click",async()=>{
  const id=$("#c-emp").value;const texto=$("#c-texto").value;if(!id||!texto.trim())return;
  try{await guardar("comunicados",nid(),{empleadoId:id,tipo:$("#c-tipo").value,fecha:hoy(),asunto:$("#c-asunto").value,texto,creado:new Date().toISOString()});toast("Comunicado registrado en el historial");}catch(err){fallo(err);}
});
function renderComunicados(){
  opcionesEmp("#c-emp",{soloActivos:true});llenarPerCom();sugerencia();
  $("#c-descargar").hidden=false;
  const box=$("#c-hist");
  const lista=[...S.com].sort((a,b)=>String(b.creado||b.fecha).localeCompare(String(a.creado||a.fecha)));
  if(!lista.length){box.innerHTML=`<p class="muted" style="margin:0">Cuando registres un comunicado como enviado, aparecerá aquí.</p>`;return;}
  box.innerHTML=lista.map(c=>{const e=empById(c.empleadoId);return `<div class="hist-item"><div class="row spread"><div><b>${esc(e?e.nombre:"(empleado eliminado)")}</b> <span class="muted">· ${esc(TIPOS[c.tipo]||c.tipo)} · ${fmt(c.fecha)}</span></div>
    <div><button class="btn link sm" data-ver-com="${esc(c.id)}">Ver texto</button><button class="btn link sm danger" data-del-com="${esc(c.id)}">Eliminar</button></div></div></div>`;}).join("");
}
$("#c-hist").addEventListener("click",async e=>{
  const v=e.target.closest("[data-ver-com]");
  if(v){const c=S.com.find(x=>x.id===v.dataset.verCom);if(!c)return;$("#c-emp").value=c.empleadoId;$("#c-tipo").value=c.tipo;$("#c-asunto").value=c.asunto||"";$("#c-texto").value=c.texto;actGmail();$("#c-editor").hidden=false;window.scrollTo(0,0);return;}
  const d=e.target.closest("[data-del-com]");
  if(d){if(!confirm("¿Eliminar este comunicado del historial?"))return;try{await borrar("comunicados",d.dataset.delCom);}catch(err){fallo(err);}}
});

/* ---------- render global ---------- */
function render(){
  llenarCfg();renderResumen();renderAusencias();renderEmpleados();renderComunicados();
}
const CLAVE="asistencia-partikle-v1";
let almacenOk=true;
function persistir(){
  if(!almacenOk)return;
  try{localStorage.setItem(CLAVE,JSON.stringify({version:1,emp:S.emp,abs:S.abs,com:S.com,cfg:S.cfg}));}
  catch(e){toast("No se pudo guardar en el navegador.");}
}
function cargar(){
  try{
    const raw=localStorage.getItem(CLAVE);
    if(raw){const d=JSON.parse(raw);aplicar(d);}
    return true;
  }catch(e){console.error(e);return false;}
}
function aplicar(d){
  S.emp=Array.isArray(d.emp)?d.emp:[];S.abs=Array.isArray(d.abs)?d.abs:[];S.com=Array.isArray(d.com)?d.com:[];
  S.cfg=Object.assign({},DEF_CFG,d.cfg||{});
}
downloads={save:({filename,data})=>{
  const blob=data instanceof Blob?data:new Blob([data],{type:filename.endsWith(".csv")?"text/csv;charset=utf-8":filename.endsWith(".json")?"application/json":"text/plain;charset=utf-8"});
  const url=URL.createObjectURL(blob);const a=document.createElement("a");a.href=url;a.download=filename;document.body.appendChild(a);a.click();
  setTimeout(()=>{URL.revokeObjectURL(url);a.remove();},1000);return Promise.resolve();
}};
function mostrarRespaldo(){
  let t="";try{t=localStorage.getItem(CLAVE+"-respaldo")||"";}catch(e){}
  $("#ultimo-respaldo").textContent=t?"Última copia descargada: "+fmt(t):"Aún no has descargado ninguna copia.";
}
$("#respaldo-bajar").addEventListener("click",()=>{
  downloads.save({filename:"respaldo-asistencia-"+hoy()+".json",data:JSON.stringify({version:1,fecha:hoy(),emp:S.emp,abs:S.abs,com:S.com,cfg:S.cfg},null,2)});
  try{localStorage.setItem(CLAVE+"-respaldo",hoy());}catch(e){}mostrarRespaldo();
});
$("#respaldo-subir").addEventListener("change",async e=>{
  const f=e.target.files[0];e.target.value="";if(!f)return;
  try{
    const d=JSON.parse(await f.text());
    if(!d||!Array.isArray(d.emp))throw new Error("formato");
    const hay=S.emp.length||S.abs.length;
    if(hay&&!confirm("Esto reemplazará los datos actuales de este navegador por los de la copia ("+d.emp.length+" empleados, "+(d.abs||[]).length+" ausencias). ¿Continuar?"))return;
    aplicar(d);persistir();render();toast("Copia restaurada");
  }catch(err){toast("El archivo no es una copia de seguridad válida.");}
});
function modo(vivo){
  const el=$("#estado-guardado");
  el.classList.toggle("off",!vivo);
  el.innerHTML=`<span class="dot"></span>`+(vivo?"Guardado en este navegador":"Sin guardar");
  $("#nota-memoria").classList.toggle("on",!vivo);
}
function iniciar(){
  almacenOk=cargar();
  try{localStorage.setItem(CLAVE+"-prueba","1");localStorage.removeItem(CLAVE+"-prueba");}catch(e){almacenOk=false;}
  modo(almacenOk);
  resetAus();llenarPerCom();ir(location.hash.slice(1)||"resumen",false);render();mostrarRespaldo();
}
iniciar();
})();
</script>
